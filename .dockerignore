# Gradle 构建文件
.gradle
# 只保留 Dockerfile 需要的发行 jar，其余 build 产物继续忽略，避免构建上下文膨胀。
build/*
!build/libs/
build/libs/*
!build/libs/*.jar
gradle/
gradlew
gradlew.bat

# IDE 配置
.idea/
.vscode/
*.iml
*.ipr
*.iws

# 数据和配置文件（这些应该通过 volume 挂载）
config/
data/
temp/
logs/

# Git
.git/
.gitignore
.gitattributes

# 测试文件
src/test/

# 文档
*.md
!README.md
docs/

# 其他
.DS_Store
*.log
