{
  "name": "hoshimi-cat-bot-webui-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.23.4 <23 || >=24.22.1 <25 || >=26.12.1 <27"
  },
  "scripts": {
    "check:node": "node scripts/check-node-version.mjs",
    "preinstall": "node scripts/check-node-version.mjs",
    "test:node": "node --test scripts/check-node-version.test.mjs",
    "dev": "node scripts/check-node-version.mjs && vite --host 127.0.0.1",
    "build": "node scripts/check-node-version.mjs && tsc -b && vite build",
    "test": "node scripts/check-node-version.mjs && npm run test:node && vitest run",
    "test:e2e": "node scripts/check-node-version.mjs && npm run build && playwright test",
    "lint": "node scripts/check-node-version.mjs && eslint .",
    "preview": "node scripts/check-node-version.mjs && vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.56.0",
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "jsdom": "^27.0.0",
    "tailwindcss": "^4.3.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.1.4",
    "vitest": "^3.2.7"
  }
}
